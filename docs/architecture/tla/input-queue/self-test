#!/usr/bin/env bash
expect_violation() {
    local name=$1 fault=$2 invariant=$3 result=0
    cat > "$name.cfg" <<CFG
CONSTANTS
    MessageCount = 2
    Fault = "$fault"
SPECIFICATION Spec
INVARIANT $invariant
CHECK_DEADLOCK FALSE
CFG
    run_tlc "$name" > "$name.log" 2>&1 || result=$?
    if [[ $result -ne 12 ]] || ! grep -Fq "Invariant $invariant is violated." "$name.log"; then
        cat "$name.log"
        echo "FAIL: $name did not violate $invariant" >&2
        exit 1
    fi
    echo "PASS: $name violated $invariant as expected"
}
expect_violation forget forget NoLostInput
expect_violation duplicate duplicate AtMostOnce
expect_violation cancelled-attach cancelled-attach CancelledNeverAttached
expect_violation after-stop after-stop StopPausesQueue
expect_violation priority-reachable none NoPriority
expect_violation paused-queue-reachable none NoPausedPending

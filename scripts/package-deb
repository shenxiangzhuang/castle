#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
binary=$(realpath "$1")
output="$repo/$2"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
root="$work/root"

version=$(cargo metadata --no-deps --format-version 1 --manifest-path "$repo/Cargo.toml" \
    | jq -r '.packages[] | select(.name == "desktop") | .version')
debian_version=$(printf '%s\n' "$version" | sed 's/-/~/')
architecture=$(dpkg --print-architecture)

mkdir -p "$work/debian" "$root/DEBIAN" "$root/usr/bin" \
    "$root/usr/share/applications" "$root/usr/share/doc/castle-desktop" \
    "$root/usr/share/icons/hicolor/512x512/apps"
printf 'Source: castle-desktop\nSection: utils\nPriority: optional\nMaintainer: castle contributors <shenxiangzhuang@users.noreply.github.com>\n\nPackage: castle-desktop\nArchitecture: any\nDescription: Native desktop interface for Castle\n' \
    > "$work/debian/control"
depends=$(cd "$work" && dpkg-shlibdeps -O -e"$binary" | sed -n 's/^shlibs:Depends=//p')

install -m 755 "$binary" "$root/usr/bin/castle-desktop"
install -m 644 "$repo/crates/desktop/resources/castle.desktop" \
    "$root/usr/share/applications/castle.desktop"
install -m 644 "$repo/crates/desktop/assets/app-icon-512.png" \
    "$root/usr/share/icons/hicolor/512x512/apps/castle.png"
install -m 644 "$repo/LICENSE" "$root/usr/share/doc/castle-desktop/copyright"
printf 'Package: castle-desktop\nVersion: %s\nArchitecture: %s\nMaintainer: castle contributors <shenxiangzhuang@users.noreply.github.com>\nDepends: %s\nSection: utils\nPriority: optional\nDescription: Native desktop interface for Castle\n' \
    "$debian_version" "$architecture" "$depends" > "$root/DEBIAN/control"

dpkg-deb --root-owner-group --build "$root" "$output"
